APP_NAME="AI-Powered Software Requirements Engineering Assistant"
APP_ENV="development"
DEBUG=True

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL="sqlite:///./sre_assistant.db"

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# LLM Configuration (Mock by default in core; Gemini/Local pluggable)
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
